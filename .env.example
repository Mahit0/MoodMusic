# -----------------------------------------------------------------------------
# Modèle de configuration. Copiez ce fichier en « .env » puis renseignez vos
# identifiants Spotify (obtenus sur https://developer.spotify.com/dashboard).
# Le vrai fichier « .env » n'est jamais versionné : il est exclu par .gitignore.
# Si ces variables sont absentes, l'application fonctionne quand même en
# retombant sur des données de démonstration.
# -----------------------------------------------------------------------------

SPOTIFY_CLIENT_ID=VOTRE_CLIENT_ID
SPOTIFY_CLIENT_SECRET=VOTRE_CLIENT_SECRET

# Port d'écoute du serveur Node (nginx fera office de proxy inverse vers ce port).
PORT=3000
